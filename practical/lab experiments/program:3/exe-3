#include <stdio.h>
#include <string.h>
int main(){char s[100],m[5][5]={{'M','F','H','I','K'},{'U','N','O','P','Q'},{'Z','V','W','X','Y'},{'E','L','A','R','G'},{'D','S','T','B','C'}};int r[26],c[26];scanf("%99s",s);
for(int i=0;i<5;i++)for(int j=0;j<5;j++)r[m[i][j]-'A']=i,c[m[i][j]-'A']=j;
for(int i=0;s[i];i+=2){int a=s[i]-'A',b=s[i+1]-'A';if(r[a]==r[b])s[i]=m[r[a]][(c[a]+1)%5],s[i+1]=m[r[b]][(c[b]+1)%5];else if(c[a]==c[b])s[i]=m[(r[a]+1)%5][c[a]],s[i+1]=m[(r[b]+1)%5][c[b]];else s[i]=m[r[a]][c[b]],s[i+1]=m[r[b]][c[a]];}printf("%s",s);}
